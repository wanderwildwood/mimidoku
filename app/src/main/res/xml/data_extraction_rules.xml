<?xml version="1.0" encoding="utf-8"?>
<!--
  What may leave the phone, on Android 12 and newer. See backup_rules.xml: the settings file
  carries the Audiobookshelf key and goes nowhere, not to a cloud backup and not to a new phone.
  Places and bookmarks live in the database and still move with a device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>
        <exclude domain="sharedpref" path="mimidoku.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>
        <exclude domain="sharedpref" path="mimidoku.xml"/>
    </device-transfer>
</data-extraction-rules>
